<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="TorsionBlue">#69CCE0</Color>
    <SolidColorBrush x:Key="TorsionBlueBrush" Color="{StaticResource TorsionBlue}"/>

    <Color x:Key="TorsionLightBlue">#d2eef5</Color>
    <SolidColorBrush x:Key="TorsionLightBlueBrush" Color="{StaticResource TorsionLightBlue}"/>

    <Color x:Key="TorsionGreen">#9BAD22</Color>
    <SolidColorBrush x:Key="TorsionGreenBrush" Color="{StaticResource TorsionGreen}"/>

    <Color x:Key="TorsionLightGreen">#e1e3b8</Color>
    <SolidColorBrush x:Key="TorsionLightGreenBrush" Color="{StaticResource TorsionLightGreen}"/>
    
    <Color x:Key="TorsionGrey">#5F6062</Color>
    <SolidColorBrush x:Key="TorsionGreyBrush" Color="{StaticResource TorsionGrey}"/>

    <Color x:Key="TorsionLightGrey">#c7c7c8</Color>
    <SolidColorBrush x:Key="TorsionLightGreyBrush" Color="{StaticResource TorsionLightGrey}"/>

    
</ResourceDictionary>
